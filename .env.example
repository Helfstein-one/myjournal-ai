# Provedor padrão: gemini ou openai
AI_PROVIDER=gemini

# Chaves de API
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Modelo (opcional, defaults: gemini-2.5-flash / gpt-4o)
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o

# Personalização do Jornal
NEWSPAPER_TITLE=MY Journal
NEWSPAPER_SUBTITLE=Edição Semanal Dedicada ao Conhecimento, Cultura e Planejamento
OWNER_NAME=Mauricio
CITY=São Paulo

# Google Calendar
# Coloque seu arquivo credentials.json baixado do Google Cloud Console na raiz do projeto
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
